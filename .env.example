# NewportHub environment. Local dev uses .dev.vars (copy this file to .dev.vars).
# Do not commit .dev.vars or .env.
#
# Live price ids are plain [vars] in wrangler.toml. Values here override those for local dev.
# Use test-mode price ids, or leave a variable empty to hide that option. Each value is a
# price id (price_…) or a product id (prod_…). A product id uses that product's active price
# for the matching interval.

PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
ADMIN_USER_IDS=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Plus, $15/month
STRIPE_PRICE_PLUS_MONTHLY=
# Plus, $149/year
STRIPE_PRICE_PLUS_YEARLY=
# Featured, $39/month
STRIPE_PRICE_FEATURED_MONTHLY=
# Featured, $350/year
STRIPE_PRICE_FEATURED_YEARLY=

# Test only. Ignored unless STRIPE_SECRET_KEY is an sk_test_ key.
# STRIPE_API_BASE=http://127.0.0.1:12111
