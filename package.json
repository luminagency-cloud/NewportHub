{
  "name": "newporthub",
  "version": "2.10.3",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "npm run build && wrangler dev --local-upstream 127.0.0.1:8787 --upstream-protocol http",
    "check": "astro check && tsc -p scripts",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "seed:local": "tsx scripts/seed-outscraper.ts --local",
    "test": "tsx --test src/lib/*.test.ts",
    "seed:categories:local": "tsx scripts/seed-categories.ts --local",
    "seed:categories:remote": "tsx scripts/seed-categories.ts --remote",
    "outscraper:queries": "tsx scripts/outscraper-queries.ts",
    "import:local": "tsx scripts/seed-outscraper.ts --local",
    "import:remote": "tsx scripts/seed-outscraper.ts --remote",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.0",
    "@clerk/astro": "^4.1.14",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-static": "1.49.0",
    "stripe": "^23.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.20.5",
    "csv-parse": "^6.2.1",
    "drizzle-kit": "^0.31.11",
    "read-excel-file": "9.3.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.1"
  },
  "private": true,
  "type": "module"
}
