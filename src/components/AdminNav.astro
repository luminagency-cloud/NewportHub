---
interface Props {
  current: 'moderation' | 'listings' | 'ads' | 'categories';
}
const { current } = Astro.props;
const link = (on: boolean) => `rounded-md px-3 py-1.5 text-sm font-medium ${on ? 'bg-sky-800 text-white' : 'text-sky-800 hover:bg-sky-50'}`;
---
<nav class="mb-6 flex flex-wrap gap-2" aria-label="Admin">
  <a href="/admin" class={link(current === 'moderation')} aria-current={current === 'moderation' ? 'page' : undefined}>Moderation</a>
  <a href="/admin/listings" class={link(current === 'listings')} aria-current={current === 'listings' ? 'page' : undefined}>Businesses</a>
  <a href="/admin/ads" class={link(current === 'ads')} aria-current={current === 'ads' ? 'page' : undefined}>Banner ads</a>
  <a href="/admin/categories" class={link(current === 'categories')} aria-current={current === 'categories' ? 'page' : undefined}>Categories</a>
</nav>
