---
import CategoryIcon from './CategoryIcon.astro';
import { cardCategory, type ListingCard } from '../lib/queries';
import { publicDescription, shuffle } from '../lib/plans';

interface Props {
  listings: ListingCard[];
}
const listings = shuffle(Astro.props.listings);
---
{listings.length > 0 && (
  <section class="mb-8" aria-label="Featured businesses">
    <h2 class="mb-3 text-xl font-semibold">Featured businesses</h2>
    <div class="flex snap-x snap-mandatory gap-4 overflow-x-auto pb-2">
      {listings.map((l) => {
        const cat = cardCategory(l);
        const description = publicDescription(l.description, l.tier);
        return (
          <article class="flex w-full shrink-0 snap-start flex-col overflow-hidden rounded-lg border border-amber-300 bg-amber-50 shadow-sm sm:w-[calc(50%-0.5rem)] lg:w-[calc(33.333%-0.67rem)]">
            {l.logoR2Key ? (
              <img src={`/media/${l.logoR2Key}`} alt="" width="640" height="240" loading="lazy" class="h-40 w-full object-cover" />
            ) : (
              <span class="flex h-40 w-full items-center justify-center bg-amber-100 text-amber-800/70">
                <CategoryIcon icon={l.categoryIcon} parentIcon={l.parentIcon} class="h-12 w-12" />
              </span>
            )}
            <div class="flex flex-1 flex-col p-4">
              <h3 class="text-lg font-semibold leading-tight">
                <a href={`/listing/${l.slug}`} class="hover:underline">{l.name}</a>
              </h3>
              <p class="mt-1 text-sm text-slate-600">
                <a href={`/${cat.link.slug}/`} class="hover:underline">{cat.label}</a>
                {' · '}
                <a href={`/${l.townSlug}/`} class="hover:underline">{l.townName}</a>
              </p>
              {description && <p class="mt-2 line-clamp-2 text-sm text-slate-700">{description}</p>}
              <div class="mt-3 flex flex-wrap gap-2">
                {l.phone && (
                  <a href={`tel:${l.phone.replace(/[^\d+]/g, '')}`} class="rounded-md bg-white px-3 py-1 text-sm font-medium text-slate-800 ring-1 ring-slate-300 hover:ring-sky-400">Call</a>
                )}
                {l.website && (
                  <a href={l.website} rel="noopener" target="_blank" class="rounded-md bg-sky-700 px-3 py-1 text-sm font-medium text-white hover:bg-sky-800">Website</a>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>
)}
