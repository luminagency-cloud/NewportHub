---
import type { ListingCard } from '../lib/queries';

interface Props {
  listing: ListingCard;
}
const { listing: l } = Astro.props;
const frame = {
  premium: 'border-amber-400 bg-amber-50 ring-2 ring-amber-300 shadow-md',
  featured: 'border-sky-300 bg-white ring-1 ring-sky-200 shadow-sm',
  free: 'border-slate-200 bg-white',
}[l.tier];
---
<article class={`relative flex gap-4 rounded-lg border p-4 ${frame}`}>
  {l.logoR2Key && (
    <img src={`/media/${l.logoR2Key}`} alt="" width="64" height="64" loading="lazy" class="h-16 w-16 shrink-0 rounded object-contain" />
  )}
  <div class="min-w-0">
    {l.tier !== 'free' && (
      <span
        class={`mb-1 inline-block rounded px-2 py-0.5 text-xs font-semibold uppercase tracking-wide ${
          l.tier === 'premium' ? 'bg-amber-400 text-amber-950' : 'bg-sky-100 text-sky-800'
        }`}
      >
        {l.tier}
      </span>
    )}
    <h3 class="font-semibold">
      <a href={`/listing/${l.slug}`} class="after:absolute after:inset-0 hover:underline">{l.name}</a>
    </h3>
    <p class="text-sm text-slate-600">
      <a href={`/${l.categorySlug}/`} class="relative z-10 hover:underline">{l.categoryName}</a>
      {' · '}
      <a href={`/${l.townSlug}/`} class="relative z-10 hover:underline">{l.townName}</a>
    </p>
    {l.address && <p class="mt-1 truncate text-sm text-slate-500">{l.address}</p>}
    {l.tier !== 'free' && l.description && <p class="mt-2 line-clamp-2 text-sm text-slate-700">{l.description}</p>}
  </div>
</article>
