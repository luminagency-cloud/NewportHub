---
import { WEEKDAYS, type Hours } from '../db/schema';
import { formatDay } from '../lib/hours-parse';
import { BASIC_DESCRIPTION_LIMIT, PAID_DESCRIPTION_LIMIT, publicDescription } from '../lib/plans';
import CategorySelect, { type CategoryGroup } from './CategorySelect.astro';

interface Props {
  categories: CategoryGroup[];
  towns: { id: number; name: string; state: string }[];
  values?: {
    name?: string | null;
    categoryId?: number | null;
    townId?: number | null;
    suggestedCategory?: string | null;
    suggestedTown?: string | null;
    address?: string | null;
    phone?: string | null;
    website?: string | null;
    email?: string | null;
    description?: string | null;
    hours?: Hours | null;
    socialUrl?: string | null;
    menuUrl?: string | null;
    bookingUrl?: string | null;
  };
  /** Allow "Other (suggest new)" for category and town. New submissions only. */
  allowSuggestions?: boolean;
  logoKey?: string | null;
  /** Extra photos besides the cover. Hidden from the public on Basic, still shown here when editable. */
  photos?: string[] | null;
  /** Basic owners cannot edit hours, links, extra photos, or move onto a subcategory. */
  locked?: boolean;
  /** Choose-your-plan page. The locked-field link. */
  planHref?: string;
  errors?: string[];
  submitLabel: string;
}
const {
  categories, towns, values = {}, allowSuggestions = false, logoKey, photos = [], locked = false, planHref, errors = [], submitLabel,
} = Astro.props;
const descriptionMax = locked ? BASIC_DESCRIPTION_LIMIT : PAID_DESCRIPTION_LIMIT;
const descriptionValue = locked ? (publicDescription(values.description ?? null, 'basic') ?? '') : (values.description ?? '');
const descriptionKept = locked && !!values.description && values.description.length > descriptionValue.length;
const input = 'mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2';
const label = 'block text-sm font-medium text-slate-700';
const optional = 'font-normal text-slate-500';
const catNew = allowSuggestions && !!values.suggestedCategory;
const categoryGroups = locked
  ? categories.map((g) => ({ ...g, subs: g.subs.filter((s) => s.id === values.categoryId) }))
  : categories;
const townNew = allowSuggestions && !!values.suggestedTown;
---
<form method="post" enctype="multipart/form-data" class="space-y-5">
  <p class="text-sm text-slate-500">Fields marked * are required. Everything else is optional.</p>
  {errors.length > 0 && (
    <div class="rounded-md border border-red-300 bg-red-50 p-4 text-sm text-red-800" role="alert">
      <p class="font-medium">Please fix the following:</p>
      <ul class="mt-1 list-disc pl-5">{errors.map((e) => <li>{e}</li>)}</ul>
    </div>
  )}
  <slot name="top" />

  <label class={label}>Business name *
    <input name="name" required maxlength="120" value={values.name ?? ''} class={input} />
  </label>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label class={label}>Category *
        <CategorySelect
          name="categoryId"
          class={input}
          data-other="suggestedCategoryWrap"
          groups={categoryGroups}
          selected={values.categoryId}
          extra={allowSuggestions ? { value: 'new', label: 'Something else (suggest a new category)', selected: catNew } : undefined}
        />
      </label>
      {locked && (
        <p class="mt-1 text-xs font-normal text-slate-500">
          Choosing a subcategory is {planHref ? <a href={planHref} class="font-medium text-sky-700 hover:underline">Available on Plus</a> : 'Available on Plus'}.
          {categoryGroups.some((g) => g.subs.length > 0) ? ' This listing keeps its current subcategory.' : ''}
        </p>
      )}
      {allowSuggestions && (
        <label id="suggestedCategoryWrap" class={`${label} mt-2`} hidden={!catNew}>New category name
          <input name="suggestedCategory" maxlength="60" value={values.suggestedCategory ?? ''} class={input} />
        </label>
      )}
    </div>
    <div>
      <label class={label}>Town *
        <select name="townId" class={input} data-other="suggestedTownWrap">
          <option value="">Choose…</option>
          {towns.map((t) => <option value={t.id} selected={!townNew && t.id === values.townId}>{t.name}, {t.state}</option>)}
          {allowSuggestions && <option value="new" selected={townNew}>Other (suggest a new town)</option>}
        </select>
      </label>
      {allowSuggestions && (
        <label id="suggestedTownWrap" class={`${label} mt-2`} hidden={!townNew}>New town name
          <input name="suggestedTown" maxlength="60" value={values.suggestedTown ?? ''} class={input} />
        </label>
      )}
    </div>
  </div>

  <label class={label}>Street address <span class={optional}>(optional)</span>
    <input name="address" maxlength="200" value={values.address ?? ''} class={input} />
  </label>

  <div class="grid gap-5 sm:grid-cols-3">
    <label class={label}>Phone <span class={optional}>(optional)</span><input name="phone" type="tel" maxlength="40" value={values.phone ?? ''} class={input} /></label>
    <label class={label}>Website <span class={optional}>(optional)</span><input name="website" type="text" inputmode="url" maxlength="300" placeholder="https://" value={values.website ?? ''} class={input} /></label>
    <label class={label}>Public email <span class={optional}>(optional)</span><input name="email" type="email" maxlength="200" value={values.email ?? ''} class={input} /></label>
  </div>

  <label class={label}>Description <span class={optional}>(optional{locked ? `, about ${BASIC_DESCRIPTION_LIMIT} characters` : ''})</span>
    <textarea name="description" rows="5" maxlength={descriptionMax} class={input}>{descriptionValue}</textarea>
    {locked && (
      <span class="mt-1 block text-xs font-normal text-slate-500">
        {descriptionKept ? 'The public page shows the first part. The rest is saved and comes back on Plus. ' : ''}
        A longer description is {planHref ? <a href={planHref} class="font-medium text-sky-700 hover:underline">Available on Plus</a> : 'Available on Plus'}.
      </span>
    )}
  </label>

  {locked ? (
    <p class="rounded-md border border-dashed border-slate-300 bg-white p-4 text-sm text-slate-600">
      Opening hours are {planHref ? <a href={planHref} class="font-medium text-sky-700 hover:underline">Available on Plus</a> : 'Available on Plus'}.
    </p>
  ) : (
    <fieldset>
      <legend class={label}>Opening hours <span class={optional}>(optional)</span></legend>
      <p class="text-xs text-slate-500">e.g. <code>9am-5pm</code>, <code>11-2pm, 5-9pm</code>, <code>Closed</code>, or <code>Open 24 hours</code>. Leave a day blank if unknown.</p>
      <div class="mt-2 grid gap-2 sm:grid-cols-2">
        {WEEKDAYS.map((d) => (
          <label class="flex items-center gap-2 text-sm">
            <span class="w-24 text-slate-600">{d}</span>
            <input name={`hours_${d}`} value={formatDay(values.hours?.[d])} class="flex-1 rounded-md border border-slate-300 bg-white px-2 py-1" />
          </label>
        ))}
      </div>
    </fieldset>
  )}

  {locked ? (
    <p class="rounded-md border border-dashed border-slate-300 bg-white p-4 text-sm text-slate-600">
      Social, menu, and booking links are {planHref ? <a href={planHref} class="font-medium text-sky-700 hover:underline">Available on Plus</a> : 'Available on Plus'}.
    </p>
  ) : (
    <div class="grid gap-5 sm:grid-cols-3">
      <label class={label}>Social link <span class={optional}>(optional)</span><input name="socialUrl" type="text" inputmode="url" maxlength="300" placeholder="https://" value={values.socialUrl ?? ''} class={input} /></label>
      <label class={label}>Menu link <span class={optional}>(optional)</span><input name="menuUrl" type="text" inputmode="url" maxlength="300" placeholder="https://" value={values.menuUrl ?? ''} class={input} /></label>
      <label class={label}>Booking link <span class={optional}>(optional)</span><input name="bookingUrl" type="text" inputmode="url" maxlength="300" placeholder="https://" value={values.bookingUrl ?? ''} class={input} /></label>
    </div>
  )}

  <div>
    <label class={label}>Cover photo <span class={optional}>(optional; PNG, JPEG, or WebP, up to 1 MB)</span>
      <input name="logo" type="file" accept="image/png,image/jpeg,image/webp" class="mt-1 block text-sm" />
    </label>
    {logoKey && (
      <div class="mt-2">
        <img src={`/media/${logoKey}`} alt="Current cover photo" width="64" height="64" class="h-16 w-16 rounded border object-contain" />
        <label class="mt-2 flex items-center gap-2 text-sm"><input type="checkbox" name="removeLogo" value="yes" /> Remove cover photo</label>
      </div>
    )}
    {locked ? (
      <p class="mt-3 text-sm text-slate-600">More photos are {planHref ? <a href={planHref} class="font-medium text-sky-700 hover:underline">Available on Plus</a> : 'Available on Plus'}. Basic includes the cover photo only.</p>
    ) : (
      <fieldset class="mt-4">
        <legend class={label}>More photos <span class={optional}>(up to 3, shown on the listing page)</span></legend>
        {(photos ?? []).length > 0 && (
          <ul class="mt-2 flex flex-wrap gap-3">
            {photos!.map((key) => (
              <li class="w-28 text-xs text-slate-600">
                <img src={`/media/${key}`} alt="" width="112" height="80" class="h-20 w-full rounded border object-cover" />
                <label class="mt-1 flex items-center gap-1"><input type="radio" name="promote" value={key} /> Use as cover</label>
                <label class="mt-1 flex items-center gap-1"><input type="checkbox" name="removePhoto" value={key} /> Remove</label>
              </li>
            ))}
          </ul>
        )}
        {(photos ?? []).length < 3 && (
          <input name="photos" type="file" accept="image/png,image/jpeg,image/webp" multiple class="mt-2 block text-sm" />
        )}
      </fieldset>
    )}
  </div>

  <slot name="note" />
  <button type="submit" class="rounded-md bg-sky-700 px-5 py-2 font-medium text-white hover:bg-sky-800">{submitLabel}</button>
</form>

<script>
  // Show the "suggest new" text field only when "Other" is selected.
  // instanceof, not a cast: the Workers types in worker-configuration.d.ts redefine the global Element.
  document.querySelectorAll('select[data-other]').forEach((select) => {
    if (!(select instanceof HTMLSelectElement)) return;
    const wrap = document.getElementById(select.dataset.other ?? '');
    if (wrap) select.addEventListener('change', () => (wrap.hidden = select.value !== 'new'));
  });
</script>
