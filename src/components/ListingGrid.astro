---
import type { ListingCard as Card } from '../lib/queries';
import { PAGE_SIZE } from '../lib/queries';
import ListingCard from './ListingCard.astro';

interface Props {
  rows: Card[];
  total: number;
  page: number;
  /** Max columns on large screens; 2 leaves room for a sidebar. */
  columns?: 2 | 3;
}
const { rows, total, page, columns = 3 } = Astro.props;
const pages = Math.max(1, Math.ceil(total / PAGE_SIZE));

function pageHref(n: number) {
  const u = new URL(Astro.url);
  if (n === 1) u.searchParams.delete('page');
  else u.searchParams.set('page', String(n));
  return u.pathname + u.search;
}
---
{rows.length === 0 ? (
  <p class="rounded-lg border border-dashed border-slate-300 p-8 text-center text-slate-500">No listings found.</p>
) : (
  <div class={`grid gap-4 sm:grid-cols-2 ${columns === 3 ? 'lg:grid-cols-3' : ''}`}>
    {rows.map((l) => <ListingCard listing={l} />)}
  </div>
)}
{pages > 1 && (
  <nav class="mt-8 flex items-center justify-center gap-4 text-sm" aria-label="Pagination">
    {page > 1 && <a href={pageHref(page - 1)} class="rounded border px-3 py-1 hover:bg-white">← Previous</a>}
    <span class="text-slate-500">Page {page} of {pages}</span>
    {page < pages && <a href={pageHref(page + 1)} class="rounded border px-3 py-1 hover:bg-white">Next →</a>}
  </nav>
)}
