---
import type { Town } from '../db/schema';
import type { TreeParent } from '../lib/queries';

interface Props {
  /** Parents, each followed by its subcategories that have their own page. */
  categories: TreeParent[];
  towns: Town[];
  q?: string;
  category?: string;
  town?: string;
}
const { categories, towns, q = '', category = '', town = '' } = Astro.props;
const field = 'rounded-md border border-slate-300 bg-white px-3 py-2';
---
<form action="/search" method="get" class="flex flex-col gap-2 sm:flex-row">
  <input name="q" type="search" value={q} placeholder="What are you looking for?" aria-label="Search" class={`${field} flex-1`} />
  <select name="category" aria-label="Category" class={field}>
    <option value="">All categories</option>
    {categories.map((p) => (
      <>
        <option value={p.slug} selected={p.slug === category}>{p.name}</option>
        {p.subs.filter((s) => s.brokenOut).map((s) => <option value={s.slug} selected={s.slug === category}>{'\u00a0\u00a0\u00a0'}{s.name}</option>)}
      </>
    ))}
  </select>
  <select name="town" aria-label="Town" class={field}>
    <option value="">All towns</option>
    {towns.map((t) => <option value={t.slug} selected={t.slug === town}>{t.name}</option>)}
  </select>
  <button type="submit" class="rounded-md bg-sky-700 px-5 py-2 font-medium text-white hover:bg-sky-800">Search</button>
</form>
