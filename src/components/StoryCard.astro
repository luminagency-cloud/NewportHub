---
interface Props {
  story: { slug: string; title: string; summary: string; listingName: string; townName: string; logoR2Key: string | null };
}
const { story: s } = Astro.props;
---
<article class="relative flex gap-4 rounded-lg border border-slate-200 bg-white p-4 hover:border-sky-400 hover:shadow-sm">
  {s.logoR2Key && <img src={`/media/${s.logoR2Key}`} alt="" width="64" height="64" loading="lazy" class="h-16 w-16 shrink-0 rounded object-contain" />}
  <div class="min-w-0">
    <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">{s.listingName} · {s.townName}</p>
    <h3 class="mt-1 font-semibold leading-snug">
      <a href={`/stories/${s.slug}`} class="after:absolute after:inset-0 hover:underline">{s.title}</a>
    </h3>
    <p class="mt-1 text-sm text-slate-600">{s.summary}</p>
  </div>
</article>
