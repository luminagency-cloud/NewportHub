---
import { Show, UserButton } from '@clerk/astro/components';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Path for <link rel="canonical">. Defaults to the current path. ?page=N (N > 1) is kept. */
  canonicalPath?: string;
  noindex?: boolean;
  /** Absolute or root-relative image for social shares. Defaults to the site card. */
  ogImage?: string;
}
const DEFAULT_DESCRIPTION = 'Find local businesses in Newport, Middletown, Portsmouth, Jamestown, and across Newport County, RI.';
const { title, description: rawDescription = DEFAULT_DESCRIPTION, canonicalPath, noindex = false, ogImage } = Astro.props;
// Search results show about 160 characters; listing descriptions can be much longer.
const flat = rawDescription.replace(/\s+/g, ' ').trim();
const description = flat.length > 160 ? `${flat.slice(0, 157).trimEnd()}…` : flat;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
// Each page of a paginated list is its own canonical page (Google's guidance), not page 1.
const page = Number(Astro.url.searchParams.get('page'));
if (Number.isInteger(page) && page > 1) canonical.searchParams.set('page', String(page));
const fullTitle = title === 'NewportHub' ? title : `${title} | NewportHub`;
const image = new URL(ogImage ?? '/og-default.png', Astro.site).href;
const largeCard = !ogImage; // the site card is 1200×630; listing logos are small squares
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="NewportHub" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    {largeCard && <><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /></>}
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content={largeCard ? 'summary_large_image' : 'summary'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex" />}
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4">
        <a href="/" class="text-xl font-bold tracking-tight text-sky-800">NewportHub</a>
        <form action="/search" method="get" class="hidden flex-1 justify-end sm:flex">
          <input
            name="q"
            type="search"
            placeholder="Search businesses"
            aria-label="Search businesses"
            class="w-full max-w-xs rounded-md border border-slate-300 px-3 py-1.5 text-sm"
          />
        </form>
        <nav class="flex shrink-0 items-center gap-3 text-sm">
          <Show when="signed-in">
            <a href="/account" class="font-medium text-sky-800 hover:underline">My listings</a>
            <UserButton />
          </Show>
          <Show when="signed-out">
            <a href="/login" class="font-medium text-sky-800 hover:underline">Business owners: sign in</a>
          </Show>
        </nav>
      </div>
    </header>
    <main class="mx-auto max-w-6xl px-4 py-8">
      <slot />
    </main>
    <footer class="border-t border-slate-200 py-8 text-center text-sm text-slate-500">
      © {new Date().getFullYear()} NewportHub · Newport County, Rhode Island
    </footer>
  </body>
</html>
