---
import Base from '../layouts/Base.astro';
export const prerender = true;
---
<Base title="Page not found" noindex>
  <h1 class="mb-2 text-2xl font-bold">Page not found</h1>
  <p class="text-slate-600">That page does not exist. <a href="/" class="text-sky-700 hover:underline">Go to the home page</a> or <a href="/search" class="text-sky-700 hover:underline">search all listings</a>.</p>
</Base>
