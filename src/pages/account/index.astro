---
import Base from '../../layouts/Base.astro';
import { accountOverview } from '../../lib/owner';
import { isAdmin } from '../../lib/auth';

const { userId } = Astro.locals.auth();
const { owned, claims, latestEdit } = await accountOverview(userId!);

// Status messages after a redirect. Fixed codes only, so the URL cannot inject text.
const NOTICES: Record<string, string> = {
  'claim-approved': 'Claim approved. Your email matches the business website, so the listing is now yours.',
  'claim-pending': 'Claim received. We will review it and email you.',
  submitted: 'Listing submitted. It will appear on the site after review.',
  updated: 'Changes saved. Your listing is waiting for review.',
  queued: 'Changes submitted for review. The live listing changes once they are approved.',
  unchanged: 'No changes to save.',
};
const notice = NOTICES[Astro.url.searchParams.get('done') ?? ''];
const statusLabel: Record<string, string> = { pending: 'Waiting for review', published: 'Live', rejected: 'Not approved' };
const badge: Record<string, string> = { pending: 'bg-amber-100 text-amber-900', published: 'bg-green-100 text-green-900', approved: 'bg-green-100 text-green-900', rejected: 'bg-red-100 text-red-900' };
---
<Base title="My listings" noindex>
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-2xl font-bold">My listings</h1>
    <div class="flex gap-3">
      {isAdmin(userId) && <a href="/admin" class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium hover:border-sky-400">Admin</a>}
      <a href="/account/new" class="rounded-md bg-sky-700 px-4 py-2 text-sm font-medium text-white hover:bg-sky-800">Add a new business</a>
    </div>
  </div>
  {notice && <p class="mb-6 rounded-md border border-sky-200 bg-sky-50 p-4 text-sm text-sky-900" role="status">{notice}</p>}

  {owned.length === 0 ? (
    <p class="rounded-lg border border-dashed border-slate-300 p-6 text-slate-600">
      You don't manage any listings yet. Find your business and choose “Claim this listing”, or add a new business.
    </p>
  ) : (
    <ul class="divide-y divide-slate-200 rounded-lg border border-slate-200 bg-white">
      {owned.map((l) => {
        const edit = latestEdit.get(l.id);
        return (
          <li class="flex flex-wrap items-center justify-between gap-3 p-4">
            <div>
              <p class="font-medium">{l.status === 'published' ? <a href={`/listing/${l.slug}`} class="hover:underline">{l.name}</a> : l.name}</p>
              <p class="mt-1 flex flex-wrap gap-2 text-xs">
                <span class={`rounded px-2 py-0.5 ${badge[l.status]}`}>{statusLabel[l.status]}</span>
                {edit?.status === 'pending' && <span class="rounded bg-amber-100 px-2 py-0.5 text-amber-900">Edit waiting for review</span>}
                {edit?.status === 'rejected' && <span class="rounded bg-red-100 px-2 py-0.5 text-red-900">Last edit not approved{edit.reviewNote ? `: ${edit.reviewNote}` : ''}</span>}
              </p>
            </div>
            <a href={`/account/listings/${l.id}`} class="text-sm font-medium text-sky-700 hover:underline">Edit</a>
          </li>
        );
      })}
    </ul>
  )}

  {claims.length > 0 && (
    <section class="mt-10">
      <h2 class="mb-3 text-lg font-semibold">My claims</h2>
      <ul class="divide-y divide-slate-200 rounded-lg border border-slate-200 bg-white text-sm">
        {claims.map((c) => (
          <li class="flex items-center justify-between gap-3 p-3">
            <a href={`/listing/${c.listingSlug}`} class="hover:underline">{c.listingName}</a>
            <span class={`rounded px-2 py-0.5 text-xs ${badge[c.status]}`}>{c.status}</span>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
