---
import Base from '../../../../layouts/Base.astro';
import ListingForm from '../../../../components/ListingForm.astro';
import { sessionUser } from '../../../../lib/auth';
import { parseListingForm, type ListingFormValues } from '../../../../lib/listing-form';
import { formOptions, getListing, openEdit, saveOwnerEdit } from '../../../../lib/owner';
import { isPaid } from '../../../../lib/plans';

const user = (await sessionUser(Astro))!;
const listing = await getListing(Number(Astro.params.id));
// Someone else's listing looks the same as a missing one.
if (!listing || listing.ownerUserId !== user.id) return new Response(null, { status: 404 });

const opts = await formOptions(listing.categoryId);
// Published and hidden listings only change through review; pending and rejected ones change directly.
const published = listing.status === 'published' || listing.status === 'hidden';
const pending = published ? await openEdit(listing.id) : undefined;
// Show the owner their unreviewed edit, not the live values, so they can keep working on it.
let values: Partial<ListingFormValues> = { ...listing, ...(pending?.changes ?? {}) };
let errors: string[] = [];

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const parsed = parseListingForm(form, { ...opts, allowSuggestions: !published });
  values = parsed.values;
  errors = parsed.errors;
  if (!errors.length) {
    const { result, logoError } = await saveOwnerEdit(user, listing, parsed.values, form);
    if (!logoError) return Astro.redirect(`/account?done=${result}`, 303);
    errors = [`Your other changes were saved, but the logo was not: ${logoError}`];
  }
}
const logoKey = pending && 'logoR2Key' in pending.changes ? pending.changes.logoR2Key : listing.logoR2Key;
const photos = pending && 'photos' in pending.changes ? pending.changes.photos : listing.photos;
const locked = !isPaid(listing.tier);
const planHref = `/account/listings/${listing.id}/plan`;
---
<Base title={`Edit ${listing.name}`} noindex>
  <p class="mb-2 text-sm"><a href="/account" class="text-sky-700 hover:underline">← My businesses</a></p>
  <h1 class="mb-2 text-2xl font-bold">Edit {listing.name}</h1>
  {published ? (
    <p class="mb-6 text-slate-600">
      Changes are reviewed before they go live. {pending && <strong>You have changes waiting for review; saving again replaces them.</strong>}
      {listing.status === 'hidden'
        ? <strong>This listing is hidden from the site by NewportHub.</strong>
        : <>{' '}<a href={`/listing/${listing.slug}`} class="text-sky-700 hover:underline">View live listing</a></>}
    </p>
  ) : (
    <p class="mb-6 text-slate-600">This listing is not live yet. Saving sends it for review again.</p>
  )}
  <ListingForm
    categories={opts.categories}
    towns={opts.towns}
    values={values}
    allowSuggestions={!published}
    logoKey={logoKey}
    photos={photos ?? []}
    locked={locked}
    planHref={planHref}
    errors={errors}
    submitLabel={published ? 'Submit changes for review' : 'Save'}
  />
</Base>
