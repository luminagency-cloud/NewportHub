---
// Category tree with live counts, unmapped import categories (map them here), and links to edit.
import { desc } from 'drizzle-orm';
import Base from '../../../layouts/Base.astro';
import AdminNav from '../../../components/AdminNav.astro';
import CategorySelect from '../../../components/CategorySelect.astro';
import CategoryIcon from '../../../components/CategoryIcon.astro';
import { isAdmin } from '../../../lib/auth';
import { saveAlias } from '../../../lib/admin-taxonomy';
import { BREAKOUT_AT, COLLAPSE_BELOW } from '../../../lib/category-rules';
import { db } from '../../../lib/db';
import { categoryTree } from '../../../lib/queries';
import { importUnmapped } from '../../../db/schema';

const { userId } = Astro.locals.auth();
if (!userId || !isAdmin(userId)) return new Response(null, { status: 404 });

let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const r = await saveAlias(String(form.get('source') ?? ''), Number(form.get('categoryId')));
  if ('ok' in r) return Astro.redirect(`/admin/categories?msg=${encodeURIComponent(r.ok)}`, 303);
  error = r.error;
}

const [tree, unmapped] = await Promise.all([
  categoryTree(),
  db().select().from(importUnmapped).orderBy(desc(importUnmapped.rows)),
]);
const msg = Astro.url.searchParams.get('msg');
const pill = 'rounded px-1.5 py-0.5 text-[11px] font-medium';
const button = 'rounded-md bg-sky-700 px-3 py-1.5 text-sm font-medium text-white hover:bg-sky-800';
---
<Base title="Categories" noindex>
  <AdminNav current="categories" />
  <div class="mb-2 flex flex-wrap items-baseline justify-between gap-2">
    <h1 class="text-2xl font-bold">Categories</h1>
    <a href="/admin/categories/new" class={button}>Add a category</a>
  </div>
  <p class="mb-6 text-sm text-slate-600">
    A subcategory gets its own page at {BREAKOUT_AT} live listings and loses it below {COLLAPSE_BELOW}. Until then its listings
    show on the parent page. Counts are live (published) listings. Click a name to rename, move, merge, or delete it, or to
    change which import categories file into it.
  </p>
  {msg && <p class="mb-4 rounded-md border border-green-300 bg-green-50 p-3 text-sm text-green-900" role="status">{msg}</p>}
  {error && <p class="mb-4 rounded-md border border-red-300 bg-red-50 p-3 text-sm text-red-900" role="alert">{error}</p>}

  {unmapped.length > 0 && (
    <section class="mb-8 rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm">
      <h2 class="mb-2 font-semibold text-amber-900">Unmapped import categories ({unmapped.length})</h2>
      <p class="mb-3 text-amber-900">These rows were not imported. Pick where each one belongs, then re-run the import to bring them in. Imports file on the parent either way.</p>
      <div class="overflow-x-auto">
        <table class="w-full text-left">
          <thead class="text-xs text-amber-800"><tr><th class="py-1">Source category</th><th class="py-1 text-right">Rows</th><th class="py-1 pl-4">Example</th><th class="py-1 pl-4">File under</th></tr></thead>
          <tbody>
            {unmapped.map((u) => (
              <tr class="border-t border-amber-200 align-middle">
                <td class="py-1">{u.sourceCategory}</td>
                <td class="py-1 text-right tabular-nums">{u.rows}</td>
                <td class="py-1 pl-4 text-amber-900">{u.example}</td>
                <td class="py-1 pl-4">
                  <form method="post" class="flex gap-2">
                    <input type="hidden" name="source" value={u.sourceCategory} />
                    <CategorySelect name="categoryId" groups={tree} required class="min-w-0 rounded-md border border-slate-300 bg-white px-2 py-1" aria-label={`Category for ${u.sourceCategory}`} />
                    <button class="rounded-md bg-amber-800 px-3 py-1 font-medium text-white hover:bg-amber-900">Map</button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <div class="grid gap-4 md:grid-cols-2">
    {tree.map((p) => (
      <section class="rounded-lg border border-slate-200 bg-white p-4 text-sm">
        <h2 class="flex items-baseline justify-between gap-2 font-semibold">
          <a href={`/admin/categories/${p.id}`} class="inline-flex items-center gap-2 hover:underline"><CategoryIcon icon={p.icon} class="h-5 w-5 text-sky-700" />{p.name}</a>
          <span class="flex items-baseline gap-3">
            <a href={`/${p.slug}/`} class="text-xs font-normal text-sky-700 hover:underline">page</a>
            <span class="tabular-nums text-slate-500">{p.total}</span>
          </span>
        </h2>
        <ul class="mt-2 space-y-0.5">
          {p.subs.map((s) => (
            <li class="flex items-center justify-between gap-2">
              <span>
                <a href={`/admin/categories/${s.id}`} class={`hover:underline ${s.own ? '' : 'text-slate-400'}`}>{s.name}</a>
                {s.brokenOut && <a href={`/${s.slug}/`} class={`${pill} ml-1 bg-green-100 text-green-900`}>own page</a>}
              </span>
              <span class="tabular-nums text-slate-500">{s.own}</span>
            </li>
          ))}
          {p.own > 0 && <li class="flex justify-between text-slate-600"><span>Other {p.name.toLowerCase()}</span><span class="tabular-nums">{p.own}</span></li>}
        </ul>
        <a href={`/admin/categories/new?parent=${p.id}`} class="mt-2 inline-block text-xs text-sky-700 hover:underline">+ Add a subcategory</a>
      </section>
    ))}
  </div>
</Base>
