---
// Add (/admin/towns/new) or edit a town: name, URL name, state, merge, delete. Old URLs keep working (301).
import Base from '../../../layouts/Base.astro';
import AdminNav from '../../../components/AdminNav.astro';
import { isAdmin } from '../../../lib/auth';
import { deleteTown, mergeTown, saveTown, townDetail, townsWithCounts } from '../../../lib/admin-taxonomy';

const { userId } = Astro.locals.auth();
if (!userId || !isAdmin(userId)) return new Response(null, { status: 404 });

const isNew = Astro.params.id === 'new';
const id = isNew ? null : Number(Astro.params.id);
const detail = id ? await townDetail(id) : undefined;
if (!isNew && !detail) return new Response(null, { status: 404 });

let values = { name: detail?.town.name ?? '', slug: detail?.town.slug ?? '', state: detail?.town.state ?? 'RI' };
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('action');
  const back = (msg: string, to: string) => Astro.redirect(`${to}?msg=${encodeURIComponent(msg)}`, 303);
  if (action === 'save') {
    const r = await saveTown(id, form);
    if ('ok' in r) return back(r.ok, `/admin/towns/${r.id}`);
    error = r.error;
    values = { name: String(form.get('name') ?? ''), slug: String(form.get('slug') ?? ''), state: String(form.get('state') ?? '') };
  } else if (id && action === 'merge') {
    if (form.get('confirm') !== 'yes') error = 'Tick the box to confirm the merge.';
    else {
      const r = await mergeTown(id, Number(form.get('intoId')));
      if ('ok' in r) return back(r.ok, '/admin/towns');
      error = r.error;
    }
  } else if (id && action === 'delete') {
    const r = await deleteTown(id);
    if ('ok' in r) return back(r.ok, '/admin/towns');
    error = r.error;
  }
}

const others = detail ? (await townsWithCounts()).filter((t) => t.id !== id) : [];
const msg = Astro.url.searchParams.get('msg');
const t = detail?.town;
const field = 'mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2';
const label = 'block text-sm font-medium text-slate-700';
const counts = detail ? Object.entries(detail.listingCounts).map(([s, n]) => `${n} ${s}`).join(', ') : '';
---
<Base title={t ? `Town: ${t.name}` : 'Add a town'} noindex>
  <AdminNav current="towns" />
  <p class="mb-2 text-sm"><a href="/admin/towns" class="text-sky-700 hover:underline">← Towns</a></p>
  <h1 class="mb-2 text-2xl font-bold">{t ? `${t.name}, ${t.state}` : 'Add a town'}</h1>
  {t && detail && (
    <p class="mb-4 text-sm text-slate-600">
      <a href={`/${t.slug}/`} class="text-sky-700 hover:underline" target="_blank">/{t.slug}/</a>
      {' '}· {detail.listingTotal ? <a href={`/admin/listings?town=${t.id}`} class="text-sky-700 hover:underline">{counts}</a> : 'no businesses'}
    </p>
  )}
  {msg && <p class="mb-4 rounded-md border border-green-300 bg-green-50 p-3 text-sm text-green-900" role="status">{msg}</p>}
  {error && <p class="mb-4 rounded-md border border-red-300 bg-red-50 p-3 text-sm text-red-900" role="alert">{error}</p>}

  <form method="post" class="grid max-w-2xl gap-4 rounded-lg border border-slate-200 bg-white p-4 sm:grid-cols-[1fr_6rem]">
    <input type="hidden" name="action" value="save" />
    <label class={label}>Name
      <input name="name" value={values.name} required maxlength="80" class={field} />
    </label>
    <label class={label}>State
      <input name="state" value={values.state} required maxlength="2" class={`${field} uppercase`} />
    </label>
    <label class={`${label} sm:col-span-2`}>URL name <span class="font-normal text-slate-500">(/…/; empty = from the name)</span>
      <input name="slug" value={values.slug} maxlength="80" class={field} />
      {t && <span class="mt-1 block text-xs font-normal text-slate-500">Changing it keeps the old address working (301). Renaming alone does not change the URL.</span>}
    </label>
    <div><button class="rounded-md bg-sky-700 px-4 py-2 font-medium text-white hover:bg-sky-800">{t ? 'Save changes' : 'Add town'}</button></div>
  </form>

  {t && detail && (
    <>
      {detail.redirects.length > 0 && <p class="mt-8 text-sm text-slate-600">Old addresses that redirect here: {detail.redirects.map((s) => `/${s}/`).join(', ')}</p>}
      <section class="mt-10 grid max-w-2xl gap-4 text-sm">
        <h2 class="text-lg font-semibold">Merge or delete</h2>
        {others.length > 0 && (
          <form method="post" class="rounded-lg border border-amber-300 bg-amber-50 p-4">
            <input type="hidden" name="action" value="merge" />
            <p class="mb-2 text-amber-900">Moves all {detail.listingTotal} business(es) and old addresses into another town, then removes this one. /{t.slug}/ redirects there.</p>
            <div class="flex flex-wrap items-center gap-2">
              <select name="intoId" required class="min-w-0 rounded-md border border-slate-300 bg-white px-2 py-1.5" aria-label="Merge into">
                <option value="">Merge into…</option>
                {others.map((o) => <option value={o.id}>{o.name}, {o.state}</option>)}
              </select>
              <label class="flex items-center gap-1"><input type="checkbox" name="confirm" value="yes" /> I’m sure</label>
              <button class="rounded-md bg-amber-800 px-3 py-1.5 font-medium text-white hover:bg-amber-900">Merge</button>
            </div>
          </form>
        )}
        {detail.listingTotal === 0 && (
          <form method="post" class="rounded-lg border border-red-300 bg-red-50 p-4">
            <input type="hidden" name="action" value="delete" />
            <p class="mb-2 text-red-900">No businesses are in this town. Deleting it makes /{t.slug}/ a 404, and the import will not re-create it.</p>
            <button class="rounded-md bg-red-700 px-3 py-1.5 font-medium text-white hover:bg-red-800">Delete town</button>
          </form>
        )}
      </section>
    </>
  )}
</Base>
