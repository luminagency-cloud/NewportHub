---
import Base from '../../../layouts/Base.astro';
import AdminNav from '../../../components/AdminNav.astro';
import { isAdmin } from '../../../lib/auth';
import { trafficSummary } from '../../../lib/traffic';
import { dayRange } from '../../../lib/traffic-rules';
import { adDay } from '../../../lib/ad-form';

const { userId } = Astro.locals.auth();
if (!userId || !isAdmin(userId)) return new Response(null, { status: 404 });

const range = dayRange(Astro.url.searchParams.get('from'), Astro.url.searchParams.get('to'), adDay());
const { totals, top } = await trafficSummary(range.from, range.to);
const tiles = [['Clicks out', totals.clicks], ['Website', totals.website], ['Phone', totals.phone], ['Directions', totals.directions], ['Email', totals.email], ['Page views', totals.view]] as const;
---
<Base title="Traffic" noindex>
  <AdminNav current="traffic" />
  <h1 class="mb-4 text-2xl font-bold">Traffic sent to businesses</h1>
  <form method="get" class="mb-6 flex flex-wrap items-end gap-2 text-sm">
    <label class="text-xs text-slate-600">From<br /><input type="date" name="from" value={range.from} class="rounded-md border border-slate-300 bg-white px-2 py-1" /></label>
    <label class="text-xs text-slate-600">To<br /><input type="date" name="to" value={range.to} class="rounded-md border border-slate-300 bg-white px-2 py-1" /></label>
    <button class="rounded-md bg-slate-800 px-3 py-1.5 font-medium text-white hover:bg-slate-900">Show</button>
  </form>

  <dl class="mb-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
    {tiles.map(([label, n]) => (
      <div class="rounded-lg border border-slate-200 bg-white p-3">
        <dt class="text-xs text-slate-500">{label}</dt>
        <dd class="text-2xl font-semibold tabular-nums">{n}</dd>
      </div>
    ))}
  </dl>

  <h2 class="mb-3 text-lg font-semibold">Top businesses by clicks out</h2>
  {top.length === 0 ? <p class="text-sm text-slate-500">No traffic recorded in this range.</p> : (
    <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs text-slate-500">
          <tr><th class="px-3 py-2">Business</th><th class="px-3 py-2 text-right">Clicks out</th><th class="px-3 py-2 text-right">Website</th><th class="px-3 py-2 text-right">Phone</th><th class="px-3 py-2 text-right">Views</th></tr>
        </thead>
        <tbody>
          {top.map((r) => (
            <tr class="border-t border-slate-100">
              <td class="px-3 py-2"><a href={`/admin/listings/${r.id}?from=${range.from}&to=${range.to}`} class="text-sky-700 hover:underline">{r.name}</a></td>
              <td class="px-3 py-2 text-right font-semibold tabular-nums">{r.clicks}</td>
              <td class="px-3 py-2 text-right tabular-nums">{r.website}</td>
              <td class="px-3 py-2 text-right tabular-nums">{r.phone}</td>
              <td class="px-3 py-2 text-right tabular-nums">{r.views}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
  <p class="mt-3 text-xs text-slate-500">Days are New York time. Crawlers and link previewers are not counted.</p>
</Base>
