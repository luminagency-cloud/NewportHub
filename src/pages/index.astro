---
import Base from '../layouts/Base.astro';
import SearchForm from '../components/SearchForm.astro';
import ListingCard from '../components/ListingCard.astro';
import BannerAd from '../components/BannerAd.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import { allTowns, categoryTree, searchListings } from '../lib/queries';

const [tree, towns, top] = await Promise.all([categoryTree(), allTowns(), searchListings({})]);
const grid = tree.filter((p) => p.total > 0);
// Subcategories that have their own page get a tile too, most listings first.
const popular = tree
  .flatMap((p) => p.subs.filter((s) => s.brokenOut && s.own > 0).map((s) => ({ ...s, parentName: p.name, parentIcon: p.icon })))
  .sort((a, b) => b.own - a.own || a.name.localeCompare(b.name));
const spotlight = top.rows.filter((l) => l.tier !== 'free').slice(0, 6);
---
<Base title="NewportHub" description="Find local businesses in Newport, Middletown, Portsmouth, Jamestown, and across Newport County, RI.">
  <BannerAd placement="home_top" class="mb-6" />
  <section class="mb-10 rounded-xl bg-sky-800 px-6 py-10 text-white">
    <h1 class="mb-2 text-3xl font-bold">Local businesses in Newport County</h1>
    <p class="mb-6 text-sky-100">Restaurants, shops, and services in Newport, RI and nearby towns.</p>
    <div class="text-slate-900"><SearchForm categories={tree} towns={towns} /></div>
  </section>

  {spotlight.length > 0 && (
    <section class="mb-10">
      <h2 class="mb-4 text-xl font-semibold">Featured businesses</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{spotlight.map((l) => <ListingCard listing={l} />)}</div>
    </section>
  )}

  <section class="mb-10">
    <h2 class="mb-4 text-xl font-semibold">Browse by category</h2>
    <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
      {grid.map((c) => (
        <li>
          <a href={`/${c.slug}/`} class="group flex h-full items-center gap-3 rounded-lg border border-slate-200 bg-white p-4 hover:border-sky-400 hover:shadow-sm">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-sky-50 text-sky-700 group-hover:bg-sky-100">
              <CategoryIcon icon={c.icon} class="h-6 w-6" />
            </span>
            <span class="min-w-0">
              <span class="block font-medium leading-tight">{c.name}</span>
              <span class="block text-sm text-slate-500">{c.total} {c.total === 1 ? 'listing' : 'listings'}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    {popular.length > 0 && (
      <>
        <h3 class="mb-3 mt-6 text-sm font-semibold uppercase tracking-wide text-slate-500">Popular</h3>
        <ul class="flex flex-wrap gap-2">
          {popular.map((s) => (
            <li><a href={`/${s.slug}/`} class="inline-flex items-center gap-1.5 rounded-full border border-slate-300 bg-white px-4 py-1.5 hover:border-sky-400"><CategoryIcon icon={s.icon} parentIcon={s.parentIcon} class="h-4 w-4 text-sky-700" />{s.name} <span class="text-slate-400">{s.own}</span></a></li>
          ))}
        </ul>
      </>
    )}
  </section>

  <section>
    <h2 class="mb-4 text-xl font-semibold">Browse by town</h2>
    <ul class="flex flex-wrap gap-2">
      {towns.map((t) => (
        <li><a href={`/${t.slug}/`} class="inline-block rounded-full border border-slate-300 bg-white px-4 py-1.5 hover:border-sky-400">{t.name}</a></li>
      ))}
    </ul>
  </section>
</Base>
