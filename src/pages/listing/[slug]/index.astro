---
import Base from '../../../layouts/Base.astro';
import { getPublishedListing } from '../../../lib/queries';
import { categoryLink } from '../../../lib/category-rules';
import { displayHours, toOpeningHoursSpec } from '../../../lib/hours';
import { TIER_LABELS, publicDescription, showsExtraPhotos, showsHours, showsLinks } from '../../../lib/plans';
import { redirectedSlug } from '../../../lib/admin-listings';
import { isAdmin } from '../../../lib/auth';
import { recordListingEvent } from '../../../lib/traffic';

const row = await getPublishedListing(Astro.params.slug!);
if (!row) {
  // A renamed listing keeps its old address.
  const moved = await redirectedSlug(Astro.params.slug!);
  return moved ? Astro.redirect(`/listing/${moved}`, 301) : new Response(null, { status: 404 });
}
const { listing: l, category, parent, town } = row;
// Breadcrumb goes through the parent; the subcategory gets its own crumb only once it has a page.
const catPage = categoryLink({ ...category, parentSlug: parent?.slug ?? null, parentName: parent?.name ?? null });

const url = new URL(`/listing/${l.slug}`, Astro.site).href;
const logo = l.logoR2Key ? new URL(`/media/${l.logoR2Key}`, Astro.site).href : undefined;
const description = publicDescription(l.description, l.tier);
const showHours = showsHours(l.tier);
const showLinks = showsLinks(l.tier);
const extras = showsExtraPhotos(l.tier) ? (l.photos ?? []) : [];
const images = [logo, ...extras.map((key) => new URL(`/media/${key}`, Astro.site).href)].filter((src): src is string => !!src);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': url,
  name: l.name,
  url: l.website ?? url,
  telephone: l.phone ?? undefined,
  email: l.email ?? undefined,
  description: description ?? undefined,
  sameAs: showLinks && l.socialUrl ? [l.socialUrl] : undefined,
  logo,
  image: images.length ? images : undefined,
  address: {
    '@type': 'PostalAddress',
    streetAddress: l.address ?? undefined,
    addressLocality: town.name,
    addressRegion: town.state,
    addressCountry: 'US',
  },
  geo: l.lat != null && l.lng != null ? { '@type': 'GeoCoordinates', latitude: l.lat, longitude: l.lng } : undefined,
  openingHoursSpecification: showHours ? toOpeningHoursSpec(l.hours) : undefined,
};
// Escape "<" so listing text can never close the script tag.
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
const hours = showHours ? displayHours(l.hours) : [];
const mapUrl = l.lat != null && l.lng != null
  ? `https://www.google.com/maps/search/?api=1&query=${l.lat},${l.lng}`
  : l.address ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(l.address)}` : undefined;
const paid = l.tier !== 'basic';
// Count the view after the response is sent, so tracking never slows the page.
Astro.locals.cfContext?.waitUntil(recordListingEvent(l.id, 'view', Astro.request.headers.get('user-agent')).catch((err) => console.error('View count failed', err)));
const { userId } = Astro.locals.auth();
---
<Base title={`${l.name} – ${category.name} in ${town.name}, ${town.state}`} description={description ?? `${l.name}, ${category.name.toLowerCase()} in ${town.name}, ${town.state}.`} canonicalPath={`/listing/${l.slug}`} ogImage={logo}>
  <script slot="head" type="application/ld+json" set:html={jsonLdText} />
  <nav class="mb-4 text-sm text-slate-500">
    <a href="/" class="hover:underline">Home</a>{' / '}
    {parent && <><a href={`/${parent.slug}/`} class="hover:underline">{parent.name}</a>{' / '}</>}
    {catPage.slug === category.slug && <><a href={`/${category.slug}/`} class="hover:underline">{category.name}</a>{' / '}</>}
    <a href={`/${catPage.slug}/${town.slug}/`} class="hover:underline">{town.name}</a>
  </nav>

  <article class={`rounded-xl border p-6 ${l.tier === 'featured' ? 'border-amber-400 bg-amber-50 ring-2 ring-amber-300' : l.tier === 'plus' ? 'border-sky-300 bg-white ring-1 ring-sky-200' : 'border-slate-200 bg-white'}`}>
    <header class="mb-6 flex items-start gap-4">
      {l.logoR2Key && <img src={`/media/${l.logoR2Key}`} alt={`${l.name} logo`} width="96" height="96" class="h-24 w-24 rounded object-contain" />}
      <div>
        {paid && <span class={`mb-1 inline-block rounded px-2 py-0.5 text-xs font-semibold uppercase ${l.tier === 'featured' ? 'bg-amber-400 text-amber-950' : 'bg-sky-100 text-sky-800'}`}>{TIER_LABELS[l.tier]}</span>}
        <h1 class="text-3xl font-bold">{l.name}</h1>
        <p class="text-slate-600">{category.name} · {town.name}, {town.state}</p>
      </div>
    </header>
    {extras.length > 0 && (
      <ul class="mb-6 flex gap-2 overflow-x-auto" aria-label="Photos">
        {extras.map((key) => (
          <li class="shrink-0"><img src={`/media/${key}`} alt="" width="96" height="64" loading="lazy" class="h-16 w-24 rounded object-cover" /></li>
        ))}
      </ul>
    )}

    <div class="grid gap-8 md:grid-cols-3">
      <div class="md:col-span-2">
        {description && <p class="mb-6 whitespace-pre-line text-slate-700">{description}{l.tier === 'basic' && l.description && description.length < l.description.length ? '…' : ''}</p>}
        {hours.length > 0 && (
          <section>
            <h2 class="mb-2 font-semibold">Hours</h2>
            <table class="text-sm">
              <tbody>
                {hours.map((h) => (
                  <tr><th scope="row" class="py-0.5 pr-6 text-left font-normal text-slate-500">{h.day}</th><td>{h.text}</td></tr>
                ))}
              </tbody>
            </table>
          </section>
        )}
      </div>
      <aside class="space-y-3 text-sm" data-listing={l.id}>
        {l.address && <p><span class="block text-slate-500">Address</span>{mapUrl ? <a href={mapUrl} data-track="directions" rel="nofollow noopener" target="_blank" class="text-sky-700 hover:underline">{l.address}</a> : l.address}</p>}
        {l.phone && <p><span class="block text-slate-500">Phone</span><a href={`tel:${l.phone.replace(/[^\d+]/g, '')}`} data-track="phone" class="text-sky-700 hover:underline">{l.phone}</a></p>}
        {l.website && <p><span class="block text-slate-500">Website</span><a href={l.website} data-track="website" rel={paid ? 'noopener' : 'nofollow noopener'} target="_blank" class="break-all text-sky-700 hover:underline">{l.website.replace(/^https?:\/\//, '').replace(/\/$/, '')}</a></p>}
        {l.email && <p><span class="block text-slate-500">Email</span><a href={`mailto:${l.email}`} data-track="email" class="break-all text-sky-700 hover:underline">{l.email}</a></p>}
        {showLinks && l.socialUrl && <p><span class="block text-slate-500">Social</span><a href={l.socialUrl} rel="noopener" target="_blank" class="break-all text-sky-700 hover:underline">{l.socialUrl.replace(/^https?:\/\//, '').replace(/\/$/, '')}</a></p>}
        {showLinks && l.menuUrl && <p><span class="block text-slate-500">Menu</span><a href={l.menuUrl} rel="noopener" target="_blank" class="break-all text-sky-700 hover:underline">View menu</a></p>}
        {showLinks && l.bookingUrl && <p><span class="block text-slate-500">Booking</span><a href={l.bookingUrl} rel="noopener" target="_blank" class="break-all text-sky-700 hover:underline">Book</a></p>}
      </aside>
    </div>
  </article>

  {l.ownerUserId && l.ownerUserId === userId ? (
    <p class="mt-6 text-sm">You manage this listing. <a href={`/account/listings/${l.id}`} class="font-medium text-sky-700 hover:underline">Edit it</a></p>
  ) : !l.ownerUserId && (
    <p class="mt-6 text-sm text-slate-600">Is this your business? <a href={`/listing/${l.slug}/claim`} class="font-medium text-sky-700 hover:underline">Claim this listing</a> to keep its details up to date.</p>
  )}
  {isAdmin(userId) && <p class="mt-2 text-sm"><a href={`/admin/listings/${l.id}`} class="font-medium text-sky-700 hover:underline">Edit in admin</a></p>}
</Base>

<script>
  // Outbound clicks (website, phone, email, directions): links point straight at the business, and
  // the click is reported with a beacon that does not hold up the navigation.
  const report = (e: Event) => {
    const link = e.target instanceof HTMLElement ? e.target.closest('a[data-track]') : null;
    const box = link?.closest('[data-listing]');
    if (!(link instanceof HTMLAnchorElement) || !(box instanceof HTMLElement)) return;
    navigator.sendBeacon('/api/track', JSON.stringify({ l: Number(box.dataset.listing), k: link.dataset.track }));
  };
  document.addEventListener('click', report);
  document.addEventListener('auxclick', report);
</script>
